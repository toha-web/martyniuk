---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { linkbuilder } from "../assets/utils/linkbuilder";

const currentLang = Astro.currentLocale || "uk";

const {absCurrentUrl, absAlterUrl, targetLang} = linkbuilder(currentLang, Astro.url.pathname);
const xDefault = currentLang === "en" ? absCurrentUrl : absAlterUrl;

const { title, description, og } = Astro.props;

if(currentLang === "uk"){
    og.locale = "uk_UA";
    og.localeAlternate = "en_GB";
}
else if(currentLang === "en"){
    og.locale = "en_GB";
    og.localeAlternate = "uk_UA";
}
---
<!DOCTYPE html>
<html lang={currentLang}>
	<head>
		<meta charset="utf-8" />
        <link rel="alternate" hreflang={currentLang} href={absCurrentUrl} />
        <link rel="alternate" hreflang={targetLang} href={absAlterUrl} />
        <link rel="alternate" hreflang="x-default" href={xDefault} />
		<meta name="viewport" content="width=device-width", initial-scale=1.0″ />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&family=Science+Gothic:wdth,wght@50..200,100..900&display=swap" rel="stylesheet">

        <meta name="description" content={description}>

        <meta property="og:title" content={og.title}>
        <meta property="og:description" content={description}>
        <meta property="og:image" content={og.image}>
        <meta property="og:url" content={absCurrentUrl}>
        <meta property="og:locale" content={og.locale} />
        <meta property="og:locale:alternate" content={og.localeAlternate} />
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Alex Martyniuk">

		<title>Alex Martyniuk{title && ` - ${title}`}</title>
	</head>
	<body>        
        <div class="wrapper">
            <Header />
            <main>
                <div class="container">
                    <slot />
                </div>
            </main>
            <Footer />
        </div>
	</body>
</html>

<style>
    .wrapper{
        width: 100%;
        height: 100%;
        min-height: 100vh;
        background-color: black;
        color: white;
        padding: 40px;
        @media all and (max-width: 960px){
            padding: 20px 30px;
        }
        @media all and (max-width: 650px){
            padding: 15px 20px;
        }
        @media all and (max-width: 500px){
            padding: 10px 15px;
        }
        @media all and (max-width: 400px){
            padding: 10px;
        }
    }

    .container{
        width: 100%;
        max-width: 1360px;
        margin: 0 auto;
    }
</style>