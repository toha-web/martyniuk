---
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

import image101 from "../../assets/images/exp-01-1.jpg";
import image102 from "../../assets/images/exp-01-2.jpg";
import image201 from "../../assets/images/exp-02-1.jpg";
import image202 from "../../assets/images/exp-02-2.jpg";
import image301 from "../../assets/images/exp-03-1.jpg";
import image302 from "../../assets/images/exp-03-2.jpg";

import video from "../../assets/video/expertise_video.mp4";
const slogan = ["expertise:", "from identity", "to experience"];
const textLeft = ["concept", "context", "clarity", "character", "system"];
const textRight = ["thinking", "shaping", "building", "evolving"];
---

<BaseLayout
    title="Expertise"
    description="Alex Martyniuk is a Ukrainian designer and art director specializing in brand identity, visual systems, and spatial design. With a keen eye for detail and a passion for creating meaningful experiences, Alex helps brands connect with their audiences through thoughtful design solutions."
    og={{
        title: "Alex Martyniuk - Designer & Art Director",
        image: "https://example.com/og-image.jpg",
    }}
>
    <PageHero media={video} slogan={slogan} textLeft={textLeft} textRight={textRight} />
    <div class="expertise-cases">
        <div class="identity-case case">
            <div class="case-id">01</div>
            <div class="case-description-block">
                <div class="case-title">brand identity</div>
                <div class="case-subtitle">building coherent brands across every touchpoint</div>
                <div class="case-description">I developing visual identities from the core concept to a consistent system of applications — defining the visual language, typography, color, graphic principles, and guidelines for how the brand lives across different touchpoints</div>
            </div>
            <div class="case-image">
                <a href="/en/work/beautyboss">
                    <Image src={image101} alt="brand identity image"/>
                </a>
            </div>
            <div class="case-image-with-tags">
                <div class="case-image">
                    <a href="/en/work/accordbank">
                        <Image src={image102} alt="brand identity image"/>
                    </a>
                </div>
                <div class="case-tags">
                    identity design<br />
                    visual systems<br />
                    logo design<br />
                    typography<br />
                    guidelines
                </div>
            </div>
        </div>
        <div class="visual-case case">
            <div class="case-id">02</div>
            <div class="case-description-block">
                <div class="case-title">campaigns &  visual<br /> communication</div>
                <div class="case-subtitle">turning brand systems into communication</div>
                <div class="case-description">I create campaign concepts and key visuals, then adapt them across digital and physical formats — social media, advertising, print, presentations, outdoor communication, and branded content</div>
            </div>
            <div class="case-image">
                <a href="/en/work/print">
                    <Image src={image201} alt="campaigns &  visual communication image"/>
                </a>
            </div>
            <div class="case-image-with-tags">
                <div class="case-image">
                    <a href="/en/work/sensebank">
                        <Image src={image202} alt="campaigns &  visual communication image"/>
                    </a>
                </div>
                <div class="case-tags">
                    creative concepts<br />
                    key visuals<br />
                    campaigns<br />
                    social media<br />
                    print<br />
                    OOH<br />
                    presentations
                </div>
            </div>
        </div>
        <div class="digital-case case">
            <div class="case-id">03</div>
            <div class="case-description-block">
                <div class="case-title">digital, motion & spatial</div>
                <div class="case-subtitle">taking visual systems beyond static graphics</div>
                <div class="case-description">I translating brand identities into digital, motion, and physical environments — from websites and animated graphics to retail displays, POS materials, navigation, and branded spaces</div>
            </div>
            <div class="case-image">
                <a href="/en/work/site">
                    <Image src={image301} alt="digital, motion & spatial image"/>
                </a>
            </div>
            <div class="case-image-with-tags">
                <div class="case-image">
                    <a href="/en/work/displays">
                        <Image src={image302} alt="digital, motion & spatial image"/>
                    </a>
                </div>
                <div class="case-tags">
                    web design<br />
                    UI<br />
                    motion design<br />
                    animation<br />
                    retail displays<br />
                    POSM<br />
                    spatial graphics
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .expertise-cases{
        width: 100%;
        display: flex;
        flex-direction: column;
        row-gap: 150px;
        justify-content: space-between;
        margin-bottom: 150px;
        @media all and (max-width: 768px){
            row-gap: 80px;
            margin-bottom: 80px;
        }
        @media all and (max-width: 600px){
            row-gap: 50px;
            margin-bottom: 50px;
        }
    }
    .case{
        display: grid;
        grid-auto-rows: clamp(20px, 3.7vw, 50px);
        grid-template-columns: repeat(15, minmax(0, 1fr));
    }

    .case-description-block{
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    .case-id{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 8.125rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        transform: translateY(-15px);
    }
    .case-title{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 3rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        margin-bottom: 10px;
    }
    .case-subtitle{
        font-family: 'Mulish', sans-serif;
        font-size: 1.5rem;
        line-height: 1.2;
        margin-bottom: 70px;
        @media all and (max-width: 960px){
            margin-bottom: 50px;
        }
        @media all and (max-width: 600px){
            margin-bottom: 30px;
        }
    }
    .case-description{
        font-family: 'Mulish', sans-serif;
        font-size: 1.5rem;
        line-height: 1.2;
        @media all and (max-width: 850px){
            font-size: 1.4rem;
        }

    }
    .case-tags{
        font-family: 'Mulish', sans-serif;
        font-size: 16px;
        font-weight: 300;
        line-height: 1.2;
        min-width: 120px;
        @media all and (max-width: 960px){
            font-size: 14px;
        }
        @media all and (max-width: 768px){
            font-size: 12px;
            min-width: 90px;
        }
        @media all and (max-width: 600px){
            font-size: 10px;
        }
    }
    .case-image-with-tags{
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 50px;
        @media all and (max-width: 960px){
            gap: 40px;
        }
        @media all and (max-width: 600px){
            gap: 20px;
        }
    }
    .case-image{
        width: 100%;
        border-radius: 25px;
        overflow: hidden;
        img{
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        filter: grayscale(100%);
        transition: all 0.25s;
        &:hover{
            filter: grayscale(0%);
        }
        @media all and (hover: none) {
            filter: grayscale(0%);
        }
        @media all and (max-width: 850px){
            border-radius: 20px;
        }
        @media all and (max-width: 600px){
            border-radius: 10px;
        }
    }

    .identity-case{
        .case-id{
            grid-column: 2 / span 2;
            grid-row: 2 / span 2;
        }
        .case-description-block{
            grid-column: 3 / span 5;
            grid-row: 2 / span 9;
            margin-left: 50px;
            margin-top: 20px;
        }
        .case-image{
            grid-column: 8 / span 4;
            grid-row: 4 / span 7;
            max-width: 258px;
            aspect-ratio: 258 / 345;
            margin: 0 auto;
            @media all and (max-width: 1250px){
                grid-column: 8 / span 3;
                grid-row: 5 / span 7;
                margin-left: 30px;
            }
        }
        .case-image-with-tags{
            grid-row: 1 / span 10;
            grid-column: 12 / span 4;
            & > .case-image{
                margin: 0;
                max-width: 348px;
                aspect-ratio: 1 / 1;
            }
        }
        @media all and (max-width: 960px){
            .case-id{
                grid-row-start: 2;
                grid-column: span 2 / 3;
                justify-self: end;
            }
            .case-description-block{
                grid-row: 2 / span 11;
                margin-left: 15px;
                margin-top: 15px;
            }
            .case-image{
                grid-row: 6 / span 7;
            }
        }
        @media all and (max-width: 768px){
            .case-image-with-tags{
                align-items: flex-end;
            }
            .case-image{
                grid-column: 10 / span 3;
                grid-row: 8 / span 7;
                margin-left: 0;
            }
            .case-description-block{
                grid-column: 3 / span 6;
            }
        }
        @media all and (max-width: 550px){
            .case-image-with-tags{
                grid-row: 7 / span 16;
                grid-column: 10 / span 7;
            }
            .case-image{
                grid-column: 7 / span 4;
                grid-row: 18 / span 9;
            }
        }
        @media all and (max-width: 450px){
            .case-image-with-tags{
                grid-row: 7 / span 16;
                grid-column: 10 / span 7;
            }
            .case-image{
                grid-column: 7 / span 4;
                grid-row: 16 / span 8;
            }
        }
        @media all and (max-width: 400px){
            .case-id{
                grid-column: 3 / span 3;
                justify-self: start;
            }
            .case-description-block{
                grid-column: 6 / span 8;
                grid-row: 2 / span 11;
                margin-left: 10px;
                margin-top: 5px;
            }
            .case-image-with-tags{
                grid-row: 14 / span 12;
                grid-column: 10 / span 7;
                align-items: flex-start;
            }
            .case-image{
                grid-column: 4 / span 4;
                grid-row: 17 / span 8;
            }
        }
    }

    .visual-case{
        .case-id{
            grid-column: 9 / span 2;
            grid-row: 3 / span 2;
            margin-left: 30px;
            @media all and (max-width: 1100px){
                margin-left: 20px;
            }
        }
        .case-description-block{
            grid-column: 11 / span 5;
            grid-row: 3 / span 9;
            margin-left: 15px;
            margin-top: 10px;
        }
        .case-image{
            grid-column: 5 / span 5;
            grid-row: 6 / span 6;
            max-width: 400px;
            aspect-ratio: 400 / 266;
            margin: -10px 25px 0;
        }
        .case-image-with-tags{
            grid-row: 1 / span 10;
            grid-column: 1 / span 4;
            & > .case-image{
                margin: 0;
                max-width: 338px;
                aspect-ratio: 1 / 1;
            }
        }
        @media all and (max-width: 960px){
            .case-id{
                grid-row-start: 2;
                grid-column: span 2 / 10;
                margin-right: 20px;
                margin-left: 0;
                justify-self: end;
            }
            .case-description-block{
                grid-row: 2 / span 10;
                grid-column: 10 / -1;
                max-width: 300px;
                margin-left: 0;
            }
            .case-image{
                grid-column: 5 / span 4;
                grid-row: 6 / span 5;
                margin: 0 0 0 20px;
            }
        }
        @media all and (max-width: 768px){
            .case-id{
                grid-column-end: 10;
            }
            .case-description-block{
                grid-row: 2 / span 11;
                grid-column: 10 / -2;
            }
            .case-image-with-tags{
                grid-row: 1 / span 14;
                grid-column: 1 / span 5;
                & > .case-image{
                    margin: 0;
                    max-width: 338px;
                    aspect-ratio: 1 / 1;
                }
            }
            .case-image{
                grid-column: 4 / span 5;
                grid-row: 11 / span 6;
                margin: 0;
            }
        }
        @media all and (max-width: 400px){
            .case-id{
                grid-column-end: 7;
            }
            .case-description-block{
                grid-row: 2 / span 14;
                grid-column: 7 / -3;
            }
            .case-image-with-tags{
                grid-row: 12 / span 17;
                justify-content: space-between;
                align-items: flex-end;
            }
            .case-image{
                grid-row: 19 / span 6;
                grid-column: 4 / span 6;
                margin: 5px;
            }
        }
    }

    .digital-case{
        .case-id{
            grid-column: 2 / span 2;
            grid-row: 3 / span 2;
        }
        .case-description-block{
            grid-column: 4 / span 5;
            grid-row: 3 / span 9;
            margin-top: 10px;
        }
        .case-description{
            max-width: 300px;
        }
        .case-image{
            grid-column: 11 / span 5;
            grid-row: 1 / span 6;
            max-width: 432px;
            aspect-ratio: 432 / 259;
            margin: 0 auto;
        }
        .case-image-with-tags{
            grid-row: 7 / span 6;
            grid-column: 8 / span 7;
            flex-direction: row;
            align-items: flex-end;
            height: fit-content;
            margin-left: 15px;
            & > .case-image{
                margin: 0;
                max-width: 358px;
                aspect-ratio: 358 / 269;
            }
        }
        @media all and (max-width: 1200px){
            .case-id{
                grid-column-end: 3;
                justify-self: end;
            }
            .case-description-block{
                grid-column-start: 3;
                margin-left: 25px;
            }
            .case-description{
                margin-left: -25px;
            }
        }
        @media all and (max-width: 960px){
            .case-id{
                grid-column: 1 / span 2;
                justify-self: start;
            }
            .case-description-block{
                grid-column: 3 / span 5;
                grid-row: 3 / span 9;
                margin-top: 10px;
                margin-left: 20px;
            }
            .case-description{
                margin-left: -50px;
            }
            .case-image-with-tags{
                grid-column: 8 / -1;
                gap: 30px;
            }
        }
        @media all and (max-width: 768px){
            .case-id{
                grid-row: 1 / span 2;
                grid-column: 2 / span 2;
            }
            .case-description-block{
                grid-column: 4 / -2;
                grid-row: 1 / span 10;
                .case-description{
                    margin: 0;
                    max-width: 150px;
                }
            }
            .case-image-with-tags{
                grid-column: 6 / span 7;
                grid-row: 15 / span 6;
                column-gap: 20px;
                margin-left: 0px;
            }
            .case-image{
                grid-column: 9 / span 5;
                grid-row: 9 / span 5;
                margin-left: 10px;
            }
        }
        @media all and (max-width: 550px){
            .case-image-with-tags{
                grid-column: 3 / span 8;
                grid-row: 19 / span 6;
                margin-left: 0px;
                & > .case-image{
                    min-width: 150px;
                }
            }
            .case-image{
                grid-column: 7 / span 5;
                grid-row: 12 / span 5;
                margin-left: 0;
                min-width: 180px;
            }
        }
        @media all and (max-width: 500px){
            .case-description-block{
                grid-column: 5 / -2;
                margin-left: 10px;
            }
        }
        @media all and (max-width: 400px){
            .case-id{
                grid-column: 1 / span 3;
            }
            .case-image{
                grid-row-start: 13;
            }
            .case-image-with-tags{
                grid-row-start: 20;
            }
            .case-description-block{
                margin-left: 0;
            }
        }
    }
</style>