---
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

import bank from "../assets/images/accord.jpg";
import site from "../assets/images/site.jpg";
import sense from "../assets/images/sense.jpg";
import boss from "../assets/images/boss.jpg";
import displays from "../assets/images/borjomi.jpg";
import print from "../assets/images/print.jpg";

import video from "../assets/video/work_screen.mp4";
const slogan = ["вибрані роботи:", "ідеї, що набули форми"];
const textLeft = ["концептуально", "ідейно", "експериментально", "професійно"];
const textRight = ["мисли", "досліджуй", "створюй", "повторюй"];
---

<BaseLayout
    title="Мої роботи"
    description="Alex Martyniuk is a Ukrainian designer and art director specializing in brand identity, visual systems, and spatial design. With a keen eye for detail and a passion for creating meaningful experiences, Alex helps brands connect with their audiences through thoughtful design solutions."
    og={{
        title: "Alex Martyniuk - Designer & Art Director",
        image: "https://example.com/og-image.jpg",
    }}
>
    <PageHero media={video} slogan={slogan} textLeft={textLeft} textRight={textRight} />
    <div class="works">
        <div class="work-accordbank">
            <div class="work-description">
                <div class="work-title">
                    <a href="/roboty/accordbank" class="with-arrow">Акордбанк</a>
                </div>
                <div class="work-subtitle">бренд-система</div>
                <div class="work-tags">
                    артдирекшн<br />
                    айдентика<br />
                    indoor | outdoor<br />
                    digital
                </div>
            </div>
            <div class="work-image">
                <a href="/roboty/accordbank">
                    <Image src={bank} alt="AccordBank project image" />
                </a>
            </div>
        </div>
        <div class="work-accordsite">
            <div class="work-description">
                <div class="work-title">
                    <a href="/roboty/site" class="with-arrow">Акордбанк</a>
                </div>
                <div class="work-subtitle">редизайн вебсайту | 2026</div>
                <div class="work-tags">
                    UI | UX-дизайн<br />
                    система візуального дизайну<br />
                    адаптивний дизайн<br />
                    впровадження SEO
                </div>
            </div>
            <div class="work-image">
                <a href="/roboty/site">
                    <Image src={site} alt="AccordBank site image" />
                </a>
            </div>
        </div>
        <div class="work-sensebank">
            <div class="work-description">
                <div class="work-title">
                    <a href="/roboty/sensebank" class="with-arrow">Sense Bank</a>
                </div>
                <div class="work-subtitle">внутрішні комунікації</div>
                <div class="work-tags">
                    креативні концепції<br />
                    візуальні системи<br />
                    кампанії<br />
                    ілюстрація<br />
                    цифрові рішення<br />
                    друкована продукція<br />
                    мерч<br />
                    події
                </div>
            </div>
            <div class="work-image">
                <a href="/roboty/sensebank">
                    <Image src={sense} alt="Sense Bank project image" />
                </a>
            </div>
        </div>
        <div class="work-beautyboss">
            <div class="work-description">
                <div class="work-title">
                    <a href="/roboty/beautyboss" class="with-arrow">Beauty B.O.S.S.</a>
                </div>
                <div class="work-subtitle">айдентика</div>
                <div class="work-tags">
                    айдентика<br />
                    артдирекшн<br />
                    друк<br />
                    мерч
                </div>
            </div>
            <div class="work-image">
                <a href="/roboty/beautyboss">
                    <Image src={boss} alt="Beauty BOSS project image" />
                </a>
            </div>
        </div>
        <div class="work-displays">
            <div class="work-description">
                <div class="work-title">
                    <a href="/roboty/displays" class="with-arrow">Ритейл-дисплеї</a>
                </div>
                <div class="work-subtitle">просторовий та промодизайн</div>
                <div class="work-tags">
                    концепція<br />
                    артдирекшн<br />
                    POSM<br />
                    виробництво
                </div>
            </div>
            <div class="work-image">
                <a href="/roboty/displays">
                    <Image src={displays} alt="Retail Displays project image" />
                </a>
            </div>
        </div>
        <div class="work-print">
            <div class="work-description">
                <div class="work-title">
                    <a href="/roboty/print" class="with-arrow">Редакційний&nbsp;та видавничий&nbsp;дизайн</a>
                </div>
                <div class="work-subtitle">вибрані роботи | 2015—2021</div>
                <div class="work-tags">
                    креативна концепція<br />
                    арт-дирекшн<br />
                    редакційний дизайн<br />
                    верстка та типографіка<br />
                    підготовка до друку
                </div>
            </div>
            <div class="work-image">
                <a href="/roboty/print">
                    <Image src={print} alt="Design project image" />
                </a>
            </div>
        </div>
        <div class="works-slogan">
            ідеї, що набули форми -<br />
            це досвід, що стоїть за ними
        </div>
    </div>
</BaseLayout>

<style>
    .works{
        width: 100%;
        margin-bottom: 150px;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-auto-rows: clamp(20px, 3.7vw, 50px);
        @media all and (max-width: 960px){
            margin-bottom: 100px;
        }
        @media all and (max-width: 768px){
            margin-bottom: 60px;
        }
        @media all and (max-width: 450px){
            margin-bottom: 50px;
        }
    }
    .work-title{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 3rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        margin-bottom: 10px;
        a{
            text-decoration: none;
            color: inherit;
        }
        @media all and (max-width: 600px){
            font-size: 3.5rem;
        }
        @media all and (max-width: 450px){
            font-size: 2.75rem;
        }
        @media all and (max-width: 400px){
            font-size: 2.1rem;
        }
    }
    .work-subtitle{
        font-family: 'Mulish', sans-serif;
        font-size: 1.5rem;
        line-height: 1;
        margin-bottom: 40px;
        @media all and (max-width: 1100px){
            margin-bottom: 30px;
        }
        @media all and (max-width: 960px){
            margin-bottom: 20px;
        }
        @media all and (max-width: 768px){
            font-size: 1.7rem;
        }
        @media all and (max-width: 600px){
            font-size: 2rem;
        }
        @media all and (max-width: 400px){
            font-size: 1.75rem;
            margin-bottom: 10px;
        }
    }
    .work-tags{
        font-family: 'Mulish', sans-serif;
        font-size: 1rem;
        line-height: 1.2;
        font-weight: 300;
        @media all and (max-width: 768px){
            font-size: 1.25rem;
        }
        @media all and (max-width: 600px){
            font-size: 1.5rem;
        }
    }
    .work-image{
        border-radius: 25px;
        overflow: hidden;
        img{
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(100%);
            transition: all 0.2s;
            &:hover{
                cursor: pointer;
                filter: grayscale(0%);
            }
            @media all and (hover: none) {
                filter: grayscale(0%);
            }
        }
        @media all and (max-width: 960px){
            border-radius: 15px;
        }
    }
    .works-slogan{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 4.875rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        grid-row: 75 / span 3;
        grid-column: 2 / -1;
        @media all and (max-width: 960px){
            grid-row: 72 / span 4;
        }
        @media all and (max-width: 650px){
            grid-row: 90 / span 4;
            grid-column-start: 1;
        }
        @media all and (max-width: 600px){
            font-size: 4.25rem;
            grid-column-start: 2;
        }
        @media all and (max-width: 500px){
            grid-row: 88 / span 4;
        }
        @media all and (max-width: 450px){
            font-size: 3.25rem;
        }
        @media all and (max-width: 400px){
            grid-row: 76 / span 3;
        }
        @media all and (max-width: 350px){
            grid-row: 71 / span 3;
            grid-column-start: 1;
            justify-self: center;
        }
    }

    .work-accordbank{
        display: contents;
        .work-description{
            grid-row: 1 / span 4;
            grid-column: 2 / span 3;
            margin-left: -30px;
        }
        .work-image{
            grid-row: 1 / span 10;
            grid-column: 5 / -1;
            max-width: 896px;
            aspect-ratio: 896 / 500;
            justify-self: end;
        }
        @media all and (max-width: 960px){
            .work-description{
                grid-column: 1 / span 4;
                margin: 0;
                padding-right: 20px;
            }
        }
        @media all and (max-width: 650px){
            .work-image{
                grid-row-start: 4;
            }
        }
        @media all and (max-width: 400px){
            .work-description{
                grid-column: 1 / span 5;
            }
            .work-image{
                grid-column-start: 6;
            }
            .work-tags{
                min-width: 100px;
            }
        }
    }

    .work-accordsite{
        display: contents;
        .work-description{
            grid-column: 10 / -1;
            grid-row: 17 / span 4;
            margin-left: -30px;
            align-self: end;
        }
        .work-image{
            grid-row: 14 / span 7;
            grid-column: 2 / span 7;
            max-width: 775px;
            aspect-ratio: 775 / 343;
            align-self: end;
        }
        @media all and (max-width: 960px){
            .work-description{
                grid-row-start: 16;
                grid-column-start: 9;
                margin: 0;
            }
            .work-image{
                grid-row-start: 13;
                transform: translateX(-30px);
            }
        }
        @media all and (max-width: 650px){
            .work-description{
                grid-row: 24 / span 7;
                grid-column: 7 / -1;
                align-self: start;
            }
            .work-image{
                grid-row-start: 16;
                transform: translateX(0);
                align-self: start;
            }
        }
        @media all and (max-width: 500px){
            .work-description{
                grid-row-start: 23;
                margin-left: -15px;
            }
            .work-image{
                grid-column: 2 / span 8;
                grid-row: 15 / span 7;
            }
        }
        @media all and (max-width: 400px){
            .work-description{
                grid-row: 20 / span 6;
                grid-column-start: 6;
                margin: 0;
            }
            .work-image{
                grid-row: 13 / span 6;
            }
        }
        @media all and (max-width: 350px){
            .work-description{
                grid-row-start: 18;
                margin-left: -5px;
            }
            .work-image{
                grid-row-start: 12;
            }
        }
    }

    .work-sensebank{
        display: contents;
        .work-description{
            grid-column: span 4 / 8;
            grid-row: 26 / span 5;
            padding-right: 50px;
            justify-self: end;
        }
        .work-image{
            grid-row: 25 / span 12;
            grid-column: 8 / -1;
            max-width: 575px;
            aspect-ratio: 1 / 1;
        }
        @media all and (max-width: 960px){
            .work-description{
                grid-row: 24 / span 6;
                grid-column: span 6 / 8;
                padding-right: 30px;
            }
            .work-image{
                grid-row-start: 23;
            }
        }
        @media all and (max-width: 650px){
            .work-description{
                grid-row-start: 34;
                grid-column: 1 / 8;
            }
            .work-image{
                grid-row-start: 33;
            }
        }
        @media all and (max-width: 400px){
            .work-description{
                grid-row: 28 / span 9;
                grid-column: 3 / span 7;
                justify-self: start;
                padding: 0;
                margin-left: -30px;
            }
            .work-image{
                grid-row: 31 / span 8;
                grid-column: 7 / span 6;
            }
        }
        @media all and (max-width: 350px){
            .work-description{
                grid-row-start: 26;
            }
            .work-image{
                grid-row-start: 29;
            }
        }
    }

    .work-beautyboss{
        display: contents;
        .work-description{
            grid-row: 40 / span 4;
            grid-column: 7 / -1;
        }
        .work-image{
            grid-column: 1 / span 5;
            grid-row: 40 / span 12;
            max-width: 580px;
            aspect-ratio: 1 / 1;
        }
        @media all and (max-width: 960px){
            .work-description{
                grid-row-start: 37;
            }
            .work-image{
                grid-row-start: 37;
            }
        }
        @media all and (max-width: 650px){
            .work-description{
                grid-row-start: 47;
                margin-left: -10px;
            }
            .work-image{
                grid-row-start: 47;
            }
        }
        @media all and (max-width: 400px){
            .work-description{
                grid-row-start: 43;
            }
            .work-image{
                grid-row-start: 43;
            }
        }
        @media all and (max-width: 350px){
            .work-description{
                grid-row-start: 39;
            }
            .work-image{
                grid-row-start: 39;
            }
        }
    }

    .work-displays{
        display: contents;
        .work-description{
            grid-column: 1 / 8;
            grid-row: span 4 / 61;
            padding-right: 100px;
            align-self: end;
            justify-self: end;
        }
        .work-image{
            grid-row: 47 / span 14;
            grid-column: 8 / span 4;
            max-width: 432px;
            aspect-ratio: 432 / 687;
            align-self: end;
        }
        @media all and (max-width: 960px){
            .work-description{
                grid-row: span 6 / 58;
                padding-right: 50px;
            }
            .work-image{
                grid-row-start: 44;
            }
        }
        @media all and (max-width: 650px){
            .work-description{
                grid-row: span 6 / 68;
            }
            .work-image{
                grid-row-start: 54;
            }
        }
        @media all and (max-width: 500px){
            .work-description{
                grid-row: 59 / span 8;
                grid-column: 1 / 8;
                justify-self: end;
                align-self: start;
                padding: 0;
            }
            .work-subtitle{
                max-width: 200px;
            }
            .work-image{
                grid-row-start: 53;
                grid-column: 9 / span 4;
                align-self: start;
            }
        }
        @media all and (max-width: 400px){
            .work-description{
                grid-row: 53 / span 8;
            }
            .work-subtitle{
                max-width: 150px;
            }
            .work-image{
                grid-row-start: 48;
            }
        }
        @media all and (max-width: 350px){
            .work-description{
                grid-row: 48 / span 8;
            }
            .work-image{
                grid-row-start: 44;
            }
        }
    }

    .work-print{
        display: contents;
        .work-description{
            grid-column: 8 / -1;
            grid-row: span 5 / 72;
            align-self: end;
        }
        .work-title > a{
            width: min-content;
            gap: 40px;
            --arrow-offset-y: 5px;
        }
        .work-image{
            grid-row: 64 / span 8;
            grid-column: 2 / span 5;
            max-width: 580px;
            aspect-ratio: 580 / 386;
            align-self: end;
        }
        @media all and (max-width: 960px){
            .work-description{
                grid-row: span 7 / 69;
                margin-left: -60px;
            }
            .work-title > a{
                gap: 20px;
            }
            .work-image{
                grid-row-start: 61;
                transform: translateX(-20px);
            }
        }
        @media all and (max-width: 768px){
            .work-description{
                grid-row: 61 / span 8;
                align-self: start;
            }
            .work-image{
                transform: translateX(0);
                grid-column-start: 1;
                align-self: start;
            }
        }
        @media all and (max-width: 650px){
            .work-description{
                grid-row: 79 / span 8;
                grid-column: 6 / -1;
                margin: 0;
            }
            .work-image{
                grid-column-start: 3;
                grid-row: 71 / span 7;
            }
        }
        @media all and (max-width: 500px){
            .work-description{
                grid-row: 77 / span 9;
                grid-column: 5 / -1;
            }
            .work-image{
                grid-row: 69 / span 7;
            }
        }
        @media all and (max-width: 400px){
            .work-description{
                grid-row: 67 / span 7;
                grid-column: 6 / -1;
            }
            .work-image{
                grid-row: 61 / span 7;
            }
        }
        @media all and (max-width: 350px){
            .work-description{
                grid-row: 62 / span 7;
                grid-column: 5 / -1;
            }
            .work-image{
                grid-row: 56 / span 5;
            }
        }
    }
</style>