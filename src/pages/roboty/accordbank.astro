---
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from "../../components/ProjectHero.astro";
import ProjectFooter from '../../components/ProjectFooter.astro';

import heroImage from "../../assets/images/accord/accord-hero.jpg";
const heroTitle = ["Акордбанк", "від логотипу", "до візуальної системи"];
const heroDate = "2024 — дотепер";
const heroDescription = ["айдентика", "артдирекшн", "кампанії", "простір", "digital", "друк", "мерч"];

const footerTitle = "Акордбанк";
const footerSubtitle = ["бренд і візуальна система", "2024 — дотепер"];
const footerDescription = heroDescription;

const projectImages = import.meta.glob<ImageMetadata>("/src/assets/images/accord/*.{jpg,png}", { eager: true, import: 'default' });
---

<BaseLayout
    title="Акордбанк"
    description="Alex Martyniuk is a Ukrainian designer and art director specializing in brand identity, visual systems, and spatial design. With a keen eye for detail and a passion for creating meaningful experiences, Alex helps brands connect with their audiences through thoughtful design solutions."
    og={{
        title: "Alex Martyniuk - Designer & Art Director",
        image: "https://example.com/og-image.jpg",
    }}
>
    <ProjectHero media={heroImage} title={heroTitle} date={heroDate} description={heroDescription}/>
    <div class="project-parts">
        <div class="project-part starting-point">
            <div class="part-id">01</div>
            <div class="part-description-block">
                <div class="part-title">відправна точка</div>
                <div class="part-subtitle">більше, ніж логотип</div>
                <div class="part-description">Початковою точкою став логотип без цілісної системи. Моєю задачею було створити навколо нього єдину візуальну мову та поширити її на комунікацію, простір, digital і повӁякденні носії</div>
            </div>
            <div class="part-image logo-ukr-image">
                <Image src={projectImages["/src/assets/images/accord/accord-logo-ukr.png"]} alt="Project description image" />
            </div>
            <div class="part-image logo-eng-image">
                <Image src={projectImages["/src/assets/images/accord/accord-logo-eng.png"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                існуюча айдентика<br />
                логотип | UA<br />
                логотип | EN
            </div>
        </div>
        <div class="project-part visual-language">
            <div class="part-id">02</div>
            <div class="part-description-block">
                <div class="part-title">візуальна мова</div>
                <div class="part-subtitle">від знака до системи</div>
                <div class="part-description">Я розробила гнучку графічну мову, що розширює айдентику за межі логотипу. Геометрія знака та наявні візуальні коди бренду стали основою впізнаваної системи для різних форматів, масштабів і точок контакту</div>
            </div>
            <div class="part-image logo-ukr-bg-image">
                <Image src={projectImages["/src/assets/images/accord/accord-logo-ukr-bg-white.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image logo-eng-bg-image">
                <Image src={projectImages["/src/assets/images/accord/accord-logo-eng-bg-red.jpg"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                розвиток системи<br />
                візуальна мова<br />
                графічні принципи<br />
                застосування
            </div>
        </div>
        <div class="project-part safe-simple">
            <div class="part-description">Цінності бренду стають частиною візуальної мови — перетворюються на модульні форми, які можна комбінувати, масштабувати й адаптувати до різних носіїв</div>
            <div class="part-image safe-pattern-eng-image">
                <Image src={projectImages["/src/assets/images/accord/pattern-eng-white.png"]} alt="Project description image" />
            </div>
            <div class="part-image safe-pattern-ukr-image">
                <Image src={projectImages["/src/assets/images/accord/pattern-ukr-red.png"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                цінності бренду<br />
                модульні форми<br />
                гнучкі композиції<br />
                масштабування
            </div>
        </div>
        <div class="project-part patterns">
            <div class="part-description">Патерн розвиває геометрію бренду у гнучкий візуальний елемент, натхнений українським орнаментом, і поєднує окремі форми в єдину систему</div>
            <div class="part-image small-pattern-image">
                <Image src={projectImages["/src/assets/images/accord/sm-pattern.png"]} alt="Project description image" />
            </div>
            <div class="part-image small-pattern-with-logo-image">
                <Image src={projectImages["/src/assets/images/accord/sm-pattern-logo.png"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                геометрія<br />
                патерн<br />
                ритм<br />
                зв’язок<br />
                впізнаваність
            </div>
            <div class="part-image big-pattern-red-image">
                <Image src={projectImages["/src/assets/images/accord/pattern-red.png"]} alt="Project description image" />
            </div>
            <div class="part-image big-pattern-grey-image">
                <Image src={projectImages["/src/assets/images/accord/pattern-grey.png"]} alt="Project description image" />
            </div>
        </div>
        <div class="project-part spatial-identity">
            <div class="part-id">03</div>
            <div class="part-description-block">
                <div class="part-title">бренд у просторі</div>
                <div class="part-subtitle">айдентика виходить назовні</div>
                <div class="part-description">
                    <p>
                        Я перенесла візуальну систему у фізичний простір банку, розробивши принципи адаптації патерну та бренд-елементів до різних архітектурних поверхонь — від скляних перегородок і вікон до зон обслуговування та входу.
                    </p>
                    <p>
                        Замість одного фіксованого рішення система змінює масштаб, щільність і композицію відповідно до простору, зберігаючи цілісність айдентики
                    </p>
                </div>
            </div>
            <div class="part-image bank-outside-image">
                <Image src={projectImages["/src/assets/images/accord/3-outside.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image bank-inside-sm-image">
                <Image src={projectImages["/src/assets/images/accord/3-inside-sm.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image bank-inside-big-image">
                <Image src={projectImages["/src/assets/images/accord/3-inside.jpg"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                простір<br />
                графіка на склі<br />
                навігація<br />
                масштаб
            </div>
        </div>
        <div class="project-part brand-communication">
            <div class="part-id">04</div>
            <div class="part-description-block brand-description">
                <div class="part-title">комунікація бренду</div>
                <div class="part-subtitle">від системи до комунікації</div>
                <div class="part-description">Візуальна айдентика перетворюється на гнучку систему комунікації для різних повідомлень, аудиторій і форматів, зберігаючи цілісний та впізнаваний образ бренду</div>
            </div>
            <div class="part-image deposit-image">
                <Image src={projectImages["/src/assets/images/accord/4-deposit.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image man-deposit-image">
                <Image src={projectImages["/src/assets/images/accord/4-man-deposit.jpg"]} alt="Project description image" />
            </div>
            <div class="part-description-block product-description">
                <div class="part-title">продуктові кампанії</div>
                <div class="part-subtitle">від продукту до зрозумілої комунікації</div>
                <div class="part-description">Продуктова комунікація поєднує фінансову інформацію з чіткою візуальною ієрархією та єдиним стилем бренду. Макети адаптуються до різних пропорцій, залишаючись частиною однієї системи</div>
            </div>
            <div class="part-image credit-image">
                <Image src={projectImages["/src/assets/images/accord/4-credit.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image auto-credit-image">
                <Image src={projectImages["/src/assets/images/accord/4-auto.jpg"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                гнучкі композиції<br />
                ієрархія інформації<br />
                цілісна айдентика
            </div>
        </div>
        <div class="project-part image-communication">
            <div class="part-description-block">
                <div class="part-title">іміджева комунікація</div>
                <div class="part-subtitle">бренд поза межами продуктів</div>
                <div class="part-description">Іміджева комунікація зміщує фокус із продуктів на сам бренд — його цінності, позиціонування та зв’язок з аудиторією. Єдина візуальна система об’єднує різні повідомлення, зберігаючи характер кожного</div>
            </div>
            <div class="part-image zsu-image">
                <Image src={projectImages["/src/assets/images/accord/4-zsu.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image poruch-image">
                <Image src={projectImages["/src/assets/images/accord/4-poruch.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image service-image">
                <Image src={projectImages["/src/assets/images/accord/4-service.jpg"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                іміджева комунікація<br />
                цінності бренду<br />
                тон комунікації<br />
                зв’язок з аудиторією
            </div>
        </div>
        <div class="project-part digital-communication">
            <div class="part-description-block">
                <div class="part-title">digital-комунікація</div>
                <div class="part-subtitle">одна система — різні формати</div>
                <div class="part-description">Візуальна мова працює в соцмережах, на рекрутингових платформах і в digital-рекламі. Модульні композиції, типографіка та графічні елементи адаптуються до різного контенту й форматів, зберігаючи впізнаваність бренду</div>
            </div>
            <div class="part-image digital-image">
                <Image src={projectImages["/src/assets/images/accord/4-digital.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image didgest-image">
                <Image src={projectImages["/src/assets/images/accord/4-didgest.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image work-image">
                <Image src={projectImages["/src/assets/images/accord/4-work.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image cashback-image">
                <Image src={projectImages["/src/assets/images/accord/4-cashback.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image zsu-green-image">
                <Image src={projectImages["/src/assets/images/accord/4-zsu-green.jpg"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                соцмережі<br />
                рекрутинг<br />
                digital-реклама<br />
                формати платформ
            </div>
        </div>
        <div class="project-part everyday-touchpoints">
            <div class="part-id">05</div>
            <div class="part-description-block touchpoints-description">
                <div class="part-title">щоденні точки контакту</div>
                <div class="part-subtitle">бренд у повсякденні</div>
                <div class="part-description">Візуальна мова продовжується в мерчі та внутрішніх матеріалах, перетворюючи практичні речі на впізнавані елементи айдентики</div>
            </div>
            <div class="part-image interior-image">
                <Image src={projectImages["/src/assets/images/accord/5-interior.jpg"]} alt="Project description image" />
            </div>
            <div class="part-image man-image">
                <Image src={projectImages["/src/assets/images/accord/5-man-sm.jpg"]} alt="Project description image" />
            </div>
            <div class="part-description-block apparel-description">
                <div class="part-description">Від одягу й сумок до канцелярії, календарів і повсякденних речей — кожен носій використовує систему по-своєму, залишаючись частиною одного бренду</div>
            </div>
            <div class="part-image person-image">
                <Image src={projectImages["/src/assets/images/accord/5-person.jpg"]} alt="Project description image" />
            </div>
            <div class="part-tags">
                мерч<br />
                одяг<br />
                канцелярія<br />
                корпоративні матеріали<br />
                повсякденні речі
            </div>
        </div>
        <div class="project-part system-action">
            <div class="part-id-description-block">
                <div class="part-id">06</div>
                <div class="part-description-block system-description">
                    <div class="part-title">система в дії</div>
                    <div class="part-subtitle">одна айдентика - багато точок контакту</div>
                </div>
            </div>
            <div class="part-image interior-big-image">
                <Image src={projectImages["/src/assets/images/accord/6-inside.jpg"]} alt="Project description image" />
            </div>
            <div class="part-description-block action-description">
                <div class="part-description">Логотип став основою гнучкої візуальної системи, що об’єднує комунікацію бренду, кампанії, digital, фізичний простір і повсякденні носії єдиною візуальною мовою</div>
            </div>
            <div class="part-tags">
                айдентика, що розвивається<br />
                пов’язані точки контакту<br />
                масштабована система<br />
                цілісний досвід
            </div>
        </div>
    </div>
    <ProjectFooter title={footerTitle}, subtitle={footerSubtitle} description={footerDescription}/>
</BaseLayout>

<style>
    .project-parts{
        display: flex;
        flex-direction: column;
        justify-content: space-between; 
        row-gap: 150px;
        margin-bottom: 150px;
        @media all and (max-width: 960px){
            row-gap: 100px;
            margin-bottom: 100px;
        }
        @media all and (max-width: 768px){
            row-gap: 80px;
            margin-bottom: 80px;
        }
        @media all and (max-width: 600px){
            row-gap: 50px;
            margin-bottom: 50px;
        }
    }
    .part-id{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 8.125rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        transform: translateY(-16%);
        @media all and (max-width: 450px){
            font-size: 6rem;
        }
    }
    .part-description-block{
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    .part-title{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 3rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        margin-bottom: 10px;
        @media all and (max-width: 450px){
            font-size: 2.5rem;
        }
    }
    .part-subtitle{
        font-family: 'Mulish', sans-serif;
        font-size: 1.5rem;
        line-height: 1.2;
        margin-bottom: 80px;
        @media all and (max-width: 960px){
            margin-bottom: 50px;
        }
        @media all and (max-width: 768px){
            margin-bottom: 40px;
        }
        @media all and (max-width: 600px){
            margin-bottom: 30px;
        }
    }
    .part-description{
        font-family: 'Mulish', sans-serif;
        font-size: 1.5rem;
        line-height: 1.2;
        @media all and (max-width: 850px){
            font-size: 1.4rem;
        }
    }
    .part-image{
        width: 100%;
        border-radius: 25px;
        overflow: hidden;
        img{
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        @media all and (max-width: 850px){
            border-radius: 20px;
        }
        @media all and (max-width: 600px){
            border-radius: 10px;
        }
    }
    .part-tags{
        font-family: 'Mulish', sans-serif;
        font-size: 16px;
        font-weight: 300;
        line-height: 1.2;
        /* min-width: 160px; */
        @media all and (max-width: 960px){
            font-size: 14px;
        }
        @media all and (max-width: 768px){
            font-size: 12px;
            /* min-width: 90px; */
        }
        @media all and (max-width: 600px){
            font-size: 10px;
        }
    }

    .project-part{
        display: grid;
        grid-auto-rows: clamp(20px, 3.7vw, 50px);
        grid-template-columns: repeat(31, minmax(0, 1fr));
    }

    .starting-point{
        .part-id{
            grid-column: 16 / span 3;
            grid-row: 1 / span 2;
        }
        .part-description-block{
            grid-column: 19 / -1;
            grid-row: 1 / span 8;
            margin-top: 20px;
            margin-left: 15px;
            max-width: 460px;
        }
        .logo-ukr-image{
            grid-column: 1 / span 10;
            grid-row: 2 / span 2;
            max-width: 420px;
            aspect-ratio: 420 / 100;
            img{
                object-fit: contain;
            }
        }
        .logo-eng-image{
            grid-column: 8 / span 10;
            grid-row: 5 / span 2;
            max-width: 420px;
            aspect-ratio: 420 / 100;
            img{
                object-fit: contain;
            }
        }
        .part-tags{
            grid-column: 1 / span 3;
            grid-row: 7 / span 2;
            min-width: 150px;
        }
        @media all and (max-width: 960px){
            .logo-eng-image{
                grid-column-start: 6;
            }
            .part-id{
                grid-column: 14 / span 4;
            }
            .part-description-block{
                grid-column-start: 18;
                margin-left: 0px;
            }
        }
        @media all and (max-width: 700px){
            .part-id{
                grid-column: 13 / span 4;
                margin-left: 15px;
            }
            .part-description-block{
                grid-column-start: 18;
                grid-row: 1 / span 9;
            }
        }
        @media all and (max-width: 600px){
            .part-id{
                grid-column: 14 / span 4;
                margin-left: -10px;
            }
        }
        @media all and (max-width: 450px){
            .part-id{
                margin: 0;
                grid-column: span 4 / 17;
                justify-self: end;
            }
            .part-description-block{
                margin: 0;
                grid-column-start: 18;
                grid-row: 1 / span 10;
            }
        }
    }

    .visual-language{
        .part-id{
            grid-column: 3 / span 3;
            grid-row: 1 / span 2;
        }
        .part-description-block{
            grid-column: 7 / span 12;
            grid-row: 1 / span 11;
            margin-top: 20px;
            max-width: 300px;
        }
        .part-description{
            max-width: 300px;
        }
        .logo-ukr-bg-image{
            grid-column: 20 / -1;
            grid-row: 2 / span 4;
            margin-top: 20px;
            max-width: 516px;
            aspect-ratio: 516 / 193;
        }
        .logo-eng-bg-image{
            grid-column: 16 / span 13;
            grid-row: 8 / span 4;
            max-width: 556px;
            aspect-ratio: 556 / 193;
        }
        .part-tags{
            grid-column: 16 / span 4;
            grid-row: 13 / span 2;
            min-width: 150px;
        }
        @media all and (max-width: 1200px){
            .part-description{
                max-width: 270px;
            }
        }
        @media all and (max-width: 1100px){
            .part-description{
                max-width: 240px;
            }
        }
        @media all and (max-width: 960px){
            .part-id{
                grid-column-start: 2;
            }
            .part-description{
                margin-left: -50px;
            }
        }
        @media all and (max-width: 768px){
            .part-id{
                grid-column-start: 1;
            }
            .part-description-block{
                grid-column: 6 / span 10;
            }
            .part-description{
                max-width: 200px;
            }
        }
        @media all and (max-width: 600px){
            .part-description{
                max-width: 180px;
            }
        }
        @media all and (max-width: 500px){
            .part-description-block{
                grid-column: 6 / span 13;
                margin-left: 10px;
            }
            .part-description{
                max-width: 180px;
                margin-left: -60px;
            }
            .logo-eng-bg-image{
                grid-column-start: 17;
            }
            .part-tags{
                grid-column-start: 17;
                grid-row: 12 / span 3;
            }
        }
        @media all and (max-width: 450px){
            .part-description-block{
                grid-column: 6 / span 15;
                margin: 0;
                .part-description{
                    margin-left: -45px;
                    max-width: 150px;
                }
            }
            .logo-ukr-bg-image{
                grid-row-start: 3;
            }
        }
        @media all and (max-width: 400px){
            .part-description-block{
                grid-column: 7 / span 15;
                .part-description{
                    max-width: 130px;
                }
            }
        }
    }

    .safe-simple{
        .part-description{
            grid-column: 14 / span 12;
            grid-row: 2 / span 2;
            margin-top: 15px;
        }
        .safe-pattern-eng-image{
            grid-column: 2 / span 9;
