---
const {media, slogan, textLeft, textRight} = Astro.props;
---

<div class="hero">
    <video autoplay muted loop>
        <source src={media} type="video/mp4">
    </video>
    <div class="hero-text">
        <div class="slogan-block">
            <div class="think">
                {textLeft.map((string: string) => <>{string} <br /></>)}
            </div>
            <div class="slogan">
                {slogan.map((string: string) => <>{string} <br /></>)}
            </div>
        </div>
        <div class="identity">
            {textRight.map((string: string) => <>{string} <br /></>)}
        </div>
    </div>
</div>

<style>
    .hero{
        width: 100%;
        margin-bottom: 150px;
        position: relative;
        padding: 80px 115px 50px 80px;
        aspect-ratio: 1360 / 600;
        clip-path: url("../assets/heroClip.svg#heroClip");
        @media all and (max-width: 1100px){
            padding: 50px 50px 25px;
        }
        @media all and (max-width: 960px){
            margin-bottom: 100px;
            padding: 30px 40px 25px;
        }
        @media all and (max-width: 768px){
            margin-bottom: 60px;
            padding: 20px 30px;
        }
        @media all and (max-width: 500px){
            margin-bottom: 50px;
            padding: 10px 20px;
        }
        @media all and (max-width: 350px){
            padding: 8px;
        }
    }

    video{
        width: 100%;
        position: absolute;
        z-index: 0;
        top: 0;
        left: 0;
        
    }

    .hero-text{
        position: relative;
        width: 100%;
        height: 100%;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: 'Mulish', sans-serif;
        font-weight: 300;
        font-size: 16px;
        line-height: 1.2;
        @media all and (max-width: 960px){
            font-size: 1.34rem;
        }
        @media all and (max-width: 768px){
            font-size: 1.2rem;
        }
        @media all and (max-width: 600px){
            font-size: 1.5rem;
        }
        @media all and (max-width: 350px){
            font-size: 1.3rem;
        }
    }
    .slogan-block{
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
    }
    .identity{
        margin-top: auto;
    }
    .slogan{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 4.875rem;
        font-weight: 400;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        @media all and (max-width: 960px){
            font-size: 4.25rem;
        }
        @media all and (max-width: 768px){
            font-size: 3.4rem;
        }
        @media all and (max-width: 600px){
            font-size: 3.2rem;
        }
        @media all and (max-width: 400px){
            font-size: 2.3rem;
        }
    }
</style>