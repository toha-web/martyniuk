---
import { getRelativeLocaleUrl } from "astro:i18n";

import { ui } from "../i18n/ui";
import { routes } from "../i18n/routes.js";

const currentLang = (Astro.currentLocale || "uk") as keyof typeof ui;
const {title, subtitle, description} = Astro.props;

const projectsList = ["accordbank", "site", "sensebank", "beautyboss", "displays", "print"];

const currentProjectName = Astro.url.pathname.split("/").filter(Boolean).at(-1) || "accordbank";
const currentProjectIndex = projectsList.indexOf(currentProjectName);
const nextProjectIndex = (currentProjectIndex + 1) % projectsList.length;
const nextProjectName = projectsList[nextProjectIndex];

const nextProjectPath = Astro.url.pathname.replace(currentProjectName, nextProjectName);
---

<div class="project-footer">
    <div class="project-footer-summary">
        <div class="project-footer-title">{title}</div>
        <div class="project-footer-subtitle">{subtitle.join(" | ")}</div>
        <div class="project-footer-description">{description.join(" | ")}</div>
    </div>
    <div class="project-footer-links">
        <a class="with-arrow" href={getRelativeLocaleUrl(currentLang, routes.work[currentLang])}>{ui[currentLang]["projectFooter.works"]}</a>
        <a href={nextProjectPath} class="with-arrow">{ui[currentLang]["projectFooter.next"]}</a>
    </div>
</div>

<style>
    .project-footer{
        padding: 0 80px;
        margin-bottom: 150px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 150px;
        @media all and (max-width: 960px){
            gap: 100px;
            margin-bottom: 100px;
            padding: 0 50px;
        }
        @media all and (max-width: 768px){
            gap: 80px;
            margin-bottom: 80px;
            padding: 0 30px;
        }
        @media all and (max-width: 500px){
            gap: 50px;
            margin-bottom: 50px;
            padding: 0 10px;
        }
        @media all and (max-width: 400px){
            padding: 0;
        }
    }

    .project-footer-title{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 4.85rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        margin-bottom: 10px;
        @media all and (max-width: 960px){
            font-size: 4rem;
        }
    }
    .project-footer-subtitle{
        font-family: 'Mulish', sans-serif;
        font-size: 1.5rem;
        line-height: 1.2;
        margin-bottom: 10px;
    }
    .project-footer-description{
        font-family: 'Mulish', sans-serif;
        font-weight: 300;
        font-size: 16px;
        line-height: 1.2;
        @media all and (max-width: 768px){
            font-size: 12px;
        }
    }
    .project-footer-links{
        font-family: 'Science Gothic', sans-serif;
        line-height: 1;
        font-size: 3rem;
        font-width: extra-condensed;
        font-stretch: extra-condensed;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;

    }
    .project-footer-links a{
        --arrow-offset-y: 5px;
        color: inherit;
        text-decoration: none;
        &::after{
            @media all and (max-width: 600px){
                --arrow-offset: calc(var(--arrow-offset-y) - 5px);
            }
        }
        @media all and (max-width: 400px){
            column-gap: 10px;
            &::after{
                width: 25px;
            }
        }
    }
    a.with-arrow:nth-of-type(1){
        flex-direction: row-reverse;
        &::after{
           rotate: 180deg;
           translate: 50px var(--arrow-offset, 0px);
           @media all and (max-width: 768px){
                translate: 35px var(--arrow-offset, 0px);
           }
           @media all and (max-width: 400px){
                translate: 25px var(--arrow-offset, 0px);
           }
        }
    }
</style>